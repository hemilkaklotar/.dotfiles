#!/usr/bin/env bash

set -e

# Default values
# Packages mirror $HOME: each folder's relative paths link to ~.
# e.g. tmux/.tmux.conf -> ~/.tmux.conf, ghostty/.config/ghostty/config.ghostty -> ~/.config/ghostty/config.ghostty
STOW_FOLDERS=${STOW_FOLDERS:-"tmux,zsh,local,git,ghostty,sesh,starship"}
DOTFILES=${DOTFILES:-"$HOME/.dotfiles"}

echo "Processing dotfiles..."

# Convert comma-separated list into array
IFS=',' read -ra FOLDERS <<< "$STOW_FOLDERS"

for folder in "${FOLDERS[@]}"; do
    echo "NOTE:: processing $folder"

    SRC_DIR="$DOTFILES/$folder"

    if [[ ! -d "$SRC_DIR" ]]; then
        echo "Skipping missing folder: $SRC_DIR"
        continue
    fi

    # Traverse files
    find "$SRC_DIR" -type f | while read -r src_file; do
        # Get relative path
        rel_path="${src_file#$SRC_DIR/}"
        target="$HOME/$rel_path"

        target_dir="$(dirname "$target")"

        # Ensure target directory exists
        mkdir -p "$target_dir"

        # Backup existing file if needed
        if [[ -e "$target" && ! -L "$target" ]]; then
            echo "Backing up $target -> $target.backup"
            mv "$target" "$target.backup"
        fi

        # Remove existing symlink
        if [[ -L "$target" ]]; then
            rm "$target"
        fi

        # Create symlink
        ln -s "$src_file" "$target"
        echo "Linked $target -> $src_file"
    done
done

echo "Done."