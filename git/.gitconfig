[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[safe]
	directory = /mnt/d/*
	directory = /mnt/d/FINAL_SITE
	directory = /mnt/d/vms-serivices/vms-bulk-upload-api-v4
[core]
	autocrlf = input
