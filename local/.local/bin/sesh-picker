#!/usr/bin/env bash
# sesh-picker: Ghostty entrypoint — fuzzy-pick a tmux session on launch.
# Enter = connect (auto-creates for zoxide dirs / configs).
# Esc / Ctrl-C / empty = drop to a plain shell.
pick=$(sesh list --icons | fzf --no-sort --ansi \
  --border-label ' sesh ' --prompt '⚡  ' \
  --header '  ^a all ^t tmux ^g configs ^x zoxide' \
  --bind 'tab:down,btab:up' \
  --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
  --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
  --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
  --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)')
rc=$?
if [ $rc -eq 130 ] || [ -z "$pick" ]; then
  exec zsh
fi
exec sesh connect "$pick"
